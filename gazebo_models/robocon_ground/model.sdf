<?xml version="1.0"?>
<sdf version="1.6">
  <model name="robocon_ground">
    <static>true</static>
    <link name="field_link">
      <!-- The collision uses the same mesh and transform as the visual field. -->
      <visual name="field_visual">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/Untitled.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="field_collision">
        <geometry>
          <mesh>
            <uri>model://robocon_ground/meshes/Untitled.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
          </bounce>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
